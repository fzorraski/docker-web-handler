# ======================================================================
#  Docker Web Handler - Environment Variables
# ======================================================================
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
#
#  All properties from application.properties can be overridden here.
#  Naming: dots (.) and hyphens (-) become underscores (_), all UPPERCASE.
#    Example: docker.connect-timeout -> DOCKER_CONNECT_TIMEOUT
#
#  Per-repository properties use the pattern:
#    repository.<setting>.<repo-name> -> REPOSITORY_<SETTING>_<REPO_NAME>
# ======================================================================


# --- Docker Daemon ---
DOCKER_HOST=unix:///var/run/docker.sock


# --- Allowed Repositories ---
# Comma-separated list of image repositories users can run.
# Leave empty to block all container creation.
ALLOWED_RUN_REPOSITORIES=


# --- Registry Credentials (per-repository) ---
# Use pipe (|) for multiple registries per repository.
# REPOSITORY_REGISTRY_URL_<REPO>=|https://registry.example.com
# REPOSITORY_REGISTRY_USERNAME_<REPO>=hubuser|privuser
# REPOSITORY_REGISTRY_PASSWORD_<REPO>=hubpass|privpass


# --- Visible Environment Variables (shown in New Container form) ---
# Comma-separated KEY=VALUE pairs.
# REPOSITORY_ENV_KEYS_<REPO>=DB_NAME=,DB_HOST=localhost


# --- Hidden Environment Variables (injected automatically) ---
# Comma-separated KEY=VALUE pairs, invisible to users.
# REPOSITORY_HIDDEN_ENV_<REPO>=SECRET_KEY=changeme,LOG_LEVEL=INFO


# --- Automatic Port Mapping ---
CONTAINER_PORT_MAPPING_ENABLED=false
CONTAINER_PORT_MAPPING_HOST_PORT_START=10000
# REPOSITORY_CONTAINER_PORTS_<REPO>=8080,9990

# --- Port Hyperlink Paths ---
# REPOSITORY_PORT_PATHS_<REPO>=8080:/app


# --- Container Expiration ---
# Default auto-expiration in minutes (480 = 8 hours).
CONTAINER_DEFAULT_EXPIRATION_MINUTES=480


# --- Container Log Rotation ---
CONTAINER_LOG_ROTATION_ENABLED=true
CONTAINER_LOG_ROTATION_MAX_SIZE=10m
CONTAINER_LOG_ROTATION_MAX_FILES=3


# --- Container Memory Limit ---
CONTAINER_MEMORY_LIMIT_ENABLED=false
# REPOSITORY_JAVA_OPTS_VAR_<REPO>=JAVA_OPTS


# --- Container Memory Guard ---
CONTAINER_MEMORY_GUARD_ENABLED=true
CONTAINER_MEMORY_GUARD_THRESHOLD_MB=2048


# --- Database Listing ---
DATABASE_LISTING_ENABLED=false
# REPOSITORY_PG_HOST_<REPO>=localhost
# REPOSITORY_PG_PORT_<REPO>=5432
# REPOSITORY_PG_USER_<REPO>=postgres
# REPOSITORY_PG_PASSWORD_<REPO>=changeme
# REPOSITORY_PG_DB_ENV_VAR_<REPO>=DB_NAME
# REPOSITORY_PG_IMAGE_<REPO>=postgres:16

# Auto-drop database when container expires.
DATABASE_DELETION_ON_EXPIRATION_ENABLED=false


# --- Database Dump Upload & Restore ---
DATABASE_DUMP_ENABLED=false
DATABASE_DUMP_UPLOAD_PASSWORD=
DATABASE_DUMP_UPLOAD_PASSWORD_REQUIRED=false
DATABASE_DUMP_OPERATIONS_PASSWORD=
DATABASE_DUMP_OPERATIONS_PASSWORD_REQUIRED=true
DATABASE_DUMP_STORAGE_DIR=data/dumps/
DATABASE_DUMP_MAX_SIZE_MB=1500


# --- Database Snapshots ---
DATABASE_SNAPSHOT_STORAGE_DIR=data/snapshots/
DATABASE_SNAPSHOT_MAX_SIZE_MB=1500


# --- Post-Restore SQL Scripts ---
POST_RESTORE_SCRIPTS_ENABLED=false
POST_RESTORE_SCRIPTS_ON_FAILURE=stop
# REPOSITORY_POST_RESTORE_MANDATORY_DIR_<REPO>=data/scripts/<repo>/mandatory
# REPOSITORY_POST_RESTORE_OPTIONAL_DIR_<REPO>=data/scripts/<repo>/optional


# --- Database Migration ---
# DATABASE_MIGRATION_ENABLED=false
# DATABASE_MIGRATION_API_URL=
# REPOSITORY_MIGRATION_API_URL_<REPO>=https://api.example.com/migrate/{sourceVersion}/{targetVersion}
# REPOSITORY_TAG_VERSION_PATTERN_<REPO>=^(?<branch>.+)-(?<version>\d+\.\d+\.\d+.*)$


# --- Container Scheduling ---
CONTAINER_SCHEDULING_ENABLED=true
CONTAINER_SCHEDULING_PASSWORD=
CONTAINER_SCHEDULING_PASSWORD_REQUIRED=false
SCHEDULE_EXECUTOR_THREADS=4


# --- Container Terminal ---
CONTAINER_TERMINAL_ENABLED=true
CONTAINER_TERMINAL_PASSWORD=
CONTAINER_TERMINAL_PASSWORD_REQUIRED=false
CONTAINER_TERMINAL_DEFAULT_SHELL=/bin/bash
CONTAINER_TERMINAL_MAX_SESSIONS=5
CONTAINER_TERMINAL_IDLE_TIMEOUT_MINUTES=30
CONTAINER_TERMINAL_UPLOAD_ENABLED=false
CONTAINER_TERMINAL_UPLOAD_MAX_SIZE_MB=100
CONTAINER_TERMINAL_UPLOAD_DEFAULT_PATH=/tmp
# Auto-run command(s) when a terminal connects, keyed by image SHORT NAME
# (last path segment, tag/digest stripped — e.g. registry/team/app:1.2 -> app).
# Multiple commands separated by ';' run in sequence; long-running ones go last.
# TERMINAL_INIT_COMMAND_MYIMAGE=clear;support-repl
CONTAINER_TERMINAL_INIT_COMMAND_DELAY_MS=300


# --- Application Database (the app's own persistence store) ---
# Users, tenants, roles, schedules, metadata, sessions, audit and counters are
# stored in a dedicated PostgreSQL database (schema managed by Flyway).
# On first boot, legacy data/*.json files are imported automatically and
# renamed to *.imported. See docs/postgres-setup.md.
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=dockerwebhandler
APP_DB_USER=dockerwebhandler
APP_DB_PASSWORD=dockerwebhandler
# "postgres" (default) or "file" (legacy JSON fallback, removed in a future release).
# For the file fallback also set APP_DB_ACTIVE=false to boot without any PostgreSQL.
PERSISTENCE_BACKEND=postgres
APP_DB_ACTIVE=true
# One-time import of legacy data/*.json files on first boot
JSON_IMPORT_ENABLED=true


# --- Application Authentication ---
APP_AUTH_ENABLED=false
# "password" = single shared password; "rbac" = per-user accounts with roles
# and tenants managed in the admin UI (feature passwords below are then
# replaced by role permissions).
APP_AUTH_MODE=password
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_TIMEOUT_MINUTES=480

# RBAC mode: seed super admin, created on first boot only (while no users exist)
RBAC_ADMIN_USERNAME=admin
RBAC_ADMIN_PASSWORD=


# --- CI/CD Pipeline API ---
CI_API_ENABLED=false
CI_API_KEY=
CI_DEFAULT_TTL_MINUTES=120
CI_MAX_TTL_MINUTES=480


# --- Webhook Notifications ---
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_ALLOW_HTTP=false
# WEBHOOK_TEMPLATE_CONTAINER_SUCCESS=
# WEBHOOK_TEMPLATE_CONTAINER_FAILURE=
# WEBHOOK_TEMPLATE_RESTORE_SUCCESS=
# WEBHOOK_TEMPLATE_RESTORE_FAILURE=


# --- Log Analyzer ---
LOG_ANALYZER_ENABLED=false
LOG_ANALYZER_PARALLEL_THREADS=auto
LOG_ANALYZER_MAX_FILE_SIZE_MB=500
LOG_ANALYZER_MAX_FILES=5
LOG_ANALYZER_FILE_TTL_MINUTES=120
LOG_ANALYZER_SLOW_THRESHOLD_MS=1000
LOG_ANALYZER_MAX_STORED_LINES=500000
LOG_ANALYZER_CONTAINER_TAIL=10000
LOG_ANALYZER_DEFAULT_PRESET=WILDFLY
# LOG_ANALYZER_SESSION_BREAK_DETECTION=true
